# Copy to .env.local for local development. Never commit real values.
# Without these, the app runs in local-only mode (no accounts, no sync).

# Postgres connection string (Neon: use the pooled connection string on Vercel).
# For local development run `npm run db:dev` and use the URL it prints.
DATABASE_URL=

# Random secret for signing sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional: enables "Continue with Google" (Google Cloud Console -> OAuth client).
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: push reminders that ring even when the app is closed. Generate with: npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# A scheduler (for example cron-job.org) calls /api/cron/reminders every minute with
# the header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Optional: password reset by email, sent through Resend (https://resend.com, free tier is enough).
# EMAIL_FROM must use a domain verified in Resend, for example: Notesflow <hello@your-domain.com>
RESEND_API_KEY=
EMAIL_FROM=
